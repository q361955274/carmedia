<?xml version="1.0" encoding="utf-8"?>
<!-- 晴空主题 · 封面占位：半透明蓝渐变 + 圆角（无封面时显示） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#1A2A44"
        android:centerColor="#121E36"
        android:endColor="#0D1628"
        android:type="linear" />
    <corners android:radius="18dp" />
</shape>
