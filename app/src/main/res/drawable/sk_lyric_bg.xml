<?xml version="1.0" encoding="utf-8"?>
<!-- 晴空主题 · 整卡封面背景的占位（无封面时显示卡片深蓝渐变） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#12203A"
        android:centerColor="#0D1628"
        android:endColor="#0A1220"
        android:type="linear" />
    <corners android:radius="16dp" />
</shape>
