<?xml version="1.0" encoding="utf-8"?>
<!-- =====================================================================
  晴空主题 小组件（第二种布局）· 照抄 ui.html skin-sky 布局
  ├─ 左侧：音源图标+名称 / 大封面(圆角22dp) / 歌名+歌手 / 蓝色渐变进度条+时间 / 控制按钮(prev·play·next)
  └─ 右侧：渐变封面背景 + 多行歌词(当前句发光蓝 #3BA0FF) + 歌词字号调节按钮(dec/标签/inc)
  配色对齐 ui.html 晴空：#3BA0FF→#1677F5 渐变、深蓝背景 #0D1628、发光蓝当前句
  注：RemoteViews 死路 — 不用裸 View、不用 RelativeLayout 依赖 center、歌词层直接挂根 FrameLayout
  ===================================================================== -->
<FrameLayout android:id="@+id/sk_root" android:background="@drawable/sk_card_bg" android:outlineProvider="background" android:clipToOutline="true" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 整卡背景（与主卡 rv_wallpaper 完全同机制）：有封面时 onCover 用 WallpaperMask.round 烤
         1296×720(1.8:1) 圆角位图 set 到本层，fitXY 不裁切、圆角正对四角、四角透明露出根背景圆角。
         已删除原 sk_lyric_bg_img / sk_lyric_scrim 两个方形盖层（它们会盖住/干扰圆角）。 -->
    <ImageView android:id="@+id/sk_wallpaper" android:background="@drawable/sk_card_bg" android:layout_width="fill_parent" android:layout_height="fill_parent" android:scaleType="fitXY" android:contentDescription="@null" />

    <!-- 外层横向：左信息列 + 右歌词列 -->
    <LinearLayout android:orientation="horizontal" android:id="@+id/sk_body" android:gravity="center_vertical" android:paddingLeft="20.0dip" android:paddingRight="16.0dip" android:paddingTop="14.0dip" android:paddingBottom="14.0dip" android:layout_width="fill_parent" android:layout_height="fill_parent">

        <!-- ===== 左侧：封面 + 歌名歌手 + 进度条 + 控制（权重 0.85，让位给右侧歌词） ===== -->
        <LinearLayout android:orientation="vertical" android:id="@+id/sk_left" android:layout_width="0.0dip" android:layout_height="fill_parent" android:layout_weight="0.85">

            <!-- 音源行：图标 + 名称 -->
            <LinearLayout android:orientation="horizontal" android:id="@+id/sk_source_row" android:gravity="center_vertical" android:layout_width="fill_parent" android:layout_height="wrap_content">
                <ImageView android:id="@+id/sk_source_icon" android:layout_width="44.0dip" android:layout_height="44.0dip" android:src="@drawable/ic_widget_music" android:contentDescription="@null" />
                <TextView android:textSize="32.0sp" android:textColor="@color/widget_artist" android:ellipsize="end" android:gravity="center_vertical" android:id="@+id/sk_source_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_default_artist" android:singleLine="true" android:includeFontPadding="false" android:shadowColor="#33000000" android:shadowDx="0.0" android:shadowDy="1.0" android:shadowRadius="3.0" android:layout_marginStart="10.0dip" />
            </LinearLayout>

            <!-- 封面 + 歌名歌手 -->
            <LinearLayout android:orientation="horizontal" android:id="@+id/sk_song_row" android:gravity="center_vertical" android:layout_width="fill_parent" android:layout_height="0.0dip" android:layout_weight="1.0" android:layout_marginTop="10.0dip">
                <FrameLayout android:id="@+id/sk_cover_frame" android:background="@drawable/sk_cover_ph" android:layout_width="120.0dip" android:layout_height="120.0dip">
                    <ImageView android:layout_gravity="center" android:id="@+id/sk_cover_ph_icon" android:layout_width="44.0dip" android:layout_height="44.0dip" android:src="@drawable/ic_widget_music" />
                    <ImageView android:id="@+id/sk_cover" android:layout_width="fill_parent" android:layout_height="fill_parent" android:scaleType="centerCrop" android:contentDescription="@string/widget_cover_desc" />
                </FrameLayout>
                <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:id="@+id/sk_title_block" android:layout_width="0.0dip" android:layout_height="wrap_content" android:layout_weight="1.0" android:layout_marginStart="14.0dip" android:layout_marginEnd="4.0dip">
                    <TextView android:textSize="24.0sp" android:textStyle="bold" android:textColor="@color/widget_title" android:ellipsize="end" android:id="@+id/sk_title_text" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/widget_default_title" android:singleLine="true" android:includeFontPadding="false" android:shadowColor="#33000000" android:shadowDx="0.0" android:shadowDy="1.0" android:shadowRadius="4.0" />
                    <TextView android:textSize="24.0sp" android:textColor="@color/widget_artist" android:ellipsize="end" android:id="@+id/sk_artist" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="6.0dip" android:text="@string/widget_default_artist" android:singleLine="true" android:includeFontPadding="false" android:shadowColor="#33000000" android:shadowDx="0.0" android:shadowDy="1.0" android:shadowRadius="3.0" />
                </LinearLayout>
            </LinearLayout>

            <!-- 进度条 + 时间 -->
            <LinearLayout android:orientation="vertical" android:id="@+id/sk_progress_area" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="10.0dip">
                <ProgressBar android:id="@+id/sk_seek" android:progressDrawable="@drawable/sk_seek_progress" android:layout_width="fill_parent" android:layout_height="8.0dip" android:max="1000" android:progress="0" style="?android:attr/progressBarStyleHorizontal" />
                <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="3.0dip">
                    <TextView android:textSize="16.0sp" android:textColor="@color/widget_artist" android:id="@+id/sk_time_cur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:includeFontPadding="false" />
                    <FrameLayout android:layout_width="0.0dip" android:layout_height="1.0dip" android:layout_weight="1.0" />
                    <TextView android:textSize="16.0sp" android:textColor="@color/widget_artist" android:id="@+id/sk_time_dur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- 控制按钮：水平居中 + 三键之间留间距分开 -->
            <LinearLayout android:orientation="horizontal" android:id="@+id/sk_controls" android:gravity="center_horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="8.0dip">
                <ImageView android:id="@+id/sk_btn_prev" android:padding="6.0dip" android:layout_width="52.0dip" android:layout_height="52.0dip" android:src="@drawable/ic_widget_prev" android:contentDescription="@string/widget_prev_desc" android:layout_marginEnd="12.0dip" />
                <FrameLayout android:id="@+id/sk_btn_play" android:background="@drawable/sk_btn_play_bg" android:layout_width="56.0dip" android:layout_height="56.0dip" android:layout_marginLeft="0.0dip" android:layout_marginRight="0.0dip">
                    <ImageView android:layout_gravity="center" android:id="@+id/sk_play_icon" android:layout_width="30.0dip" android:layout_height="30.0dip" android:src="@drawable/ic_widget_play" android:contentDescription="@string/widget_play_desc" />
                </FrameLayout>
                <ImageView android:id="@+id/sk_btn_next" android:padding="6.0dip" android:layout_width="52.0dip" android:layout_height="52.0dip" android:src="@drawable/ic_widget_next" android:contentDescription="@string/widget_next_desc" android:layout_marginStart="12.0dip" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 右侧：多行歌词 + 字号调节（权重 1.15，更大；无衬底，直接露出封面渐变） ===== -->
        <LinearLayout android:orientation="vertical" android:id="@+id/sk_lyrics" android:layout_width="0.0dip" android:layout_height="fill_parent" android:layout_weight="1.15" android:layout_marginStart="16.0dip">

                <!-- 顶部：歌词字号调节（dec / 标签 / inc） -->
                <LinearLayout android:orientation="horizontal" android:id="@+id/sk_lyric_ctl" android:gravity="center" android:layout_width="fill_parent" android:layout_height="wrap_content">
                    <ImageView android:id="@+id/sk_btn_lyric_dec" android:padding="4.0dip" android:layout_width="40.0dip" android:layout_height="40.0dip" android:src="@drawable/ic_widget_lyric_dec" android:contentDescription="@string/widget_lyric_dec_desc" />
                    <TextView android:textSize="24.0sp" android:textStyle="bold" android:textColor="@color/widget_title" android:gravity="center" android:id="@+id/sk_lyric_size_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="32" android:layout_marginStart="6.0dip" android:layout_marginEnd="6.0dip" />
                    <ImageView android:id="@+id/sk_btn_lyric_inc" android:padding="4.0dip" android:layout_width="40.0dip" android:layout_height="40.0dip" android:src="@drawable/ic_widget_lyric_inc" android:contentDescription="@string/widget_lyric_inc_desc" />
                </LinearLayout>

                <!-- 歌词区：多行（±4），当前句居中发光 -->
                <LinearLayout android:gravity="center_horizontal" android:orientation="vertical" android:id="@+id/sk_lyric_list" android:layout_width="fill_parent" android:layout_height="0.0dip" android:layout_weight="1.0">
                    <FrameLayout android:layout_width="fill_parent" android:layout_height="0.0dip" android:layout_weight="1.0" />
                    <TextView android:textSize="20.0sp" android:textColor="@color/widget_lyric_m4" android:ellipsize="end" android:gravity="center" android:id="@+id/sk_lyric_m4" android:paddingLeft="2.0dip" android:paddingRight="2.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="" android:singleLine="true" android:includeFontPadding="false" />
                    <TextView android:textSize="20.0sp" android:textColor="@color/widget_lyric_m3" android:ellipsize="end" android:gravity="center" android:id="@+id/sk_lyric_m3" android:paddingLeft="2.0dip" android:paddingRight="2.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="2.0dip" android:text="" android:singleLine="true" android:includeFontPadding="false" />
                    <TextView android:textSize="20.0sp" android:textColor="@color/widget_lyric_m2" android:ellipsize="end" android:gravity="center" android:id="@+id/sk_lyric_m2" android:paddingLeft="2.0dip" android:paddingRight="2.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="2.0dip" android:text="" android:singleLine="true" android:includeFontPadding="false" />
                    <TextView android:textSize="20.0sp" android:textColor="@color/widget_lyric_m1" android:ellipsize="end" android:gravity="center" android:id="@+id/sk_lyric_m1" android:paddingLeft="2.0dip" android:paddingRight="2.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="2.0dip" android:text="" android:singleLine="true" android:includeFontPadding="false" />
                    <TextView android:textSize="24.0sp" android:textStyle="bold" android:textColor="@color/widget_lyric_cur" android:ellipsize="end" android:gravity="center" android:id="@+id/sk_lyric_cur" android:paddingLeft="2.0dip" android:paddingRight="2.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="4.0dip" android:layout_marginBottom="4.0dip" android:text="@string/widget_default_lyric" android:singleLine="true" android:includeFontPadding="false" android:shadowColor="@color/widget_lyric_cur_shadow" android:shadowDx="0.0" android:shadowDy="1.0" android:shadowRadius="10.0" />
                    <TextView android:textSize="20.0sp" android:textColor="@color/widget_lyric_next" android:ellipsize="end" android:gravity="center" android:id="@+id/sk_lyric_n1" android:paddingLeft="2.0dip" android:paddingRight="2.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="2.0dip" android:text="" android:singleLine="true" android:includeFontPadding="false" />
                    <TextView android:textSize="20.0sp" android:textColor="@color/widget_lyric_3" android:ellipsize="end" android:gravity="center" android:id="@+id/sk_lyric_n2" android:paddingLeft="2.0dip" android:paddingRight="2.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="2.0dip" android:text="" android:singleLine="true" android:includeFontPadding="false" />
                    <TextView android:textSize="20.0sp" android:textColor="@color/widget_lyric_4" android:ellipsize="end" android:gravity="center" android:id="@+id/sk_lyric_n3" android:paddingLeft="2.0dip" android:paddingRight="2.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="2.0dip" android:text="" android:singleLine="true" android:includeFontPadding="false" />
                    <TextView android:textSize="20.0sp" android:textColor="@color/widget_lyric_n4" android:ellipsize="end" android:gravity="center" android:id="@+id/sk_lyric_n4" android:paddingLeft="2.0dip" android:paddingRight="2.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="2.0dip" android:text="" android:singleLine="true" android:includeFontPadding="false" />
                    <FrameLayout android:layout_width="fill_parent" android:layout_height="0.0dip" android:layout_weight="1.0" />
                </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
