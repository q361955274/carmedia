<?xml version="1.0" encoding="utf-8"?>
<!-- 主卡（CarMediaWidget）卡片背景【夜间】：不透明深蓝渐变。
     说明：rv_wallpaper(ImageView) 的 src 是壁纸圆角位图，覆盖在本 background 之上——
     所以 background 不透明只决定"壁纸未加载时"的底色（深色卡片底，不再透明露桌面），
     以及壁纸四角透明处露出的圆角底色；不会盖住壁纸本身。
     圆角 18dp 作为宿主 clipToOutline 的 outline 来源（与日间一致）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#FF0B1626"
        android:centerColor="#FF0F1D31"
        android:endColor="#FF0A1424"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#4A3B9BFF" />
    <corners android:radius="18dp" />
</shape>
