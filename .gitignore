# ============================================================
# CarMedia 工程 .gitignore（UTF-8，中文分类注释）
# ============================================================

# ---------- 1. 构建产物 ----------
build/
app/build/
.gradle/
*.apk
*.aab
*.idsig
*.log

# ---------- 2. 本机配置（含真实凭据/本机路径，严禁入库） ----------
local.properties

# ---------- 3. 签名密钥 / 证书（严禁入库） ----------
*.jks
*.keystore
*.key
*.p12

# ---------- 4. 编辑器 / IDE 配置 ----------
.idea/
*.iml
.vscode/

# ---------- 5. 备份 / 临时 / 乱码文件 ----------
*.bak*
*.orig
*.fixed
*.garbled*

# ---------- 6. 操作系统残留文件 ----------
Thumbs.db
.DS_Store

# ---------- 7. 本机专用脚本（未跟踪，按需保留） ----------
push-ui.bat
